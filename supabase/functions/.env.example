# ---------------------------------------------------------------------------
# Edge Function secrets — SERVER-ONLY. Copy to supabase/functions/.env for
# `supabase functions serve` (git-ignored), and set them on a hosted project
# with:  supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# the Supabase platform automatically — do not set or commit them. These values
# must never appear in the web app, the mobile app, an APK or the repo.
# ---------------------------------------------------------------------------

# development | staging | production. Production refuses the payment simulator.
APP_ENV=development
# Browser origins allowed by CORS (comma-separated): the web app and the Capacitor WebView.
ALLOWED_ORIGINS=http://localhost:3000,https://localhost,capacitor://localhost
# Public web app URL, used for payment return redirects.
PUBLIC_APP_URL=http://localhost:3000
# Optional: public functions URL if behind a custom domain (defaults to SUPABASE_URL/functions/v1).
# FUNCTIONS_PUBLIC_URL=

# live = real bKash / SSLCommerz calls. simulator = deterministic local testing (never in production).
PAYMENT_PROVIDER_MODE=simulator
# Simulator session signing secret (development only). Generate: openssl rand -hex 32
PAYMENT_SIMULATOR_SECRET=

# Shared secret the scheduler sends to send-notification (x-cron-secret). At least 32 characters.
CRON_SECRET=

# Which request header carries the client IP behind your proxy, and which entry to trust.
CLIENT_IP_HEADER=x-forwarded-for
CLIENT_IP_POSITION=first

# Firebase Cloud Messaging (HTTP v1) service account — push notifications.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Private key with literal \n line breaks.
FCM_PRIVATE_KEY=
