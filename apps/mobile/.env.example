# "mock" for local demos or "supabase" for the shared hosted/local Supabase backend
VITE_DATA_SOURCE=mock
# Public values only. NEVER put the service-role key in a VITE_ variable — it would ship inside the APK.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only after adding android/app/google-services.json (FCM). Registering without it crashes the app.
VITE_PUSH_ENABLED=false
VITE_SHOW_DEMO_TOOLS=true
# Public web host used by the Merchant Dashboard "View storefront" action.
VITE_PUBLIC_APP_URL=https://bazarhq.vercel.app
# Optional future wildcard/custom domain used for App Links.
VITE_ROOT_DOMAIN=bazarhq.com
