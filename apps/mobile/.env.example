# "mock" (default) or "supabase" (adapter not implemented yet)
VITE_DATA_SOURCE=mock
# Public values only. NEVER put the service-role key in a VITE_ variable — it would ship inside the APK.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only after adding android/app/google-services.json (FCM). Registering without it crashes the app.
VITE_PUSH_ENABLED=false
VITE_SHOW_DEMO_TOOLS=true
# Host used to map App Links (https://<store>.bazarhq.com/...) to in-app screens
VITE_ROOT_DOMAIN=bazarhq.com
