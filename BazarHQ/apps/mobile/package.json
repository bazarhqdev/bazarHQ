{
  "name": "@bazarhq/mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@bazarhq/shared": "*",
    "@bazarhq/ui": "*",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/browser": "^8.0.5",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "@supabase/supabase-js": "^2.118.0",
    "react-hook-form": "^7.90.0",
    "@hookform/resolvers": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bazarhq/config": "*",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  }
}
