# Data source for the service layer: "mock" (default) or "supabase" (adapter not implemented yet).
NEXT_PUBLIC_DATA_SOURCE=mock
# Public Supabase values only. NEVER put the service-role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shows the demo account helper and "reset demo data" controls.
NEXT_PUBLIC_SHOW_DEMO_TOOLS=true
# Store subdomains: <store>.<root> is served from /store/<store>
NEXT_PUBLIC_ROOT_DOMAIN=bazarhq.com
# Server-side only. IPs/CIDRs allowed to reach /admin. Unset in production = blocked.
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
