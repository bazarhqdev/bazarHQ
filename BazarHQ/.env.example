# ---------------------------------------------------------------------------
# BazarHQ — environment template. Copy what you need into:
#   apps/web/.env.local      (Next.js; read at build/start)
#   apps/mobile/.env         (Vite; baked into the APK at build time)
# NEVER put the Supabase service-role key in this repo, in any NEXT_PUBLIC_ or
# VITE_ variable, in client/mobile code or in an APK. It belongs only in the
# Edge Function / server secret store (Supabase Vault / project secrets).
# ---------------------------------------------------------------------------

# ---- Web (apps/web) -------------------------------------------------------
# "mock" (default) or "supabase" (adapter contract only — not implemented yet)
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Root domain for store subdomains: <store>.bazarhq.com → /store/<store>
NEXT_PUBLIC_ROOT_DOMAIN=bazarhq.com
# Demo helpers (demo accounts, reset data, simulated admin network). Turn off in production.
NEXT_PUBLIC_SHOW_DEMO_TOOLS=true
# Server-side only (no NEXT_PUBLIC_ prefix): IPs / IPv4 CIDRs allowed to reach /admin.
# Unset in production = /admin is blocked (fail closed). "*" allows all — local demos only.
# The proxy in front of Next.js must overwrite X-Forwarded-For (Vercel, Cloudflare and Nginx do).
ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# ---- Mobile (apps/mobile) -------------------------------------------------
VITE_DATA_SOURCE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ROOT_DOMAIN=bazarhq.com
# Enable only after adding android/app/google-services.json (FCM).
VITE_PUSH_ENABLED=false
VITE_SHOW_DEMO_TOOLS=true

# ---- Android release signing (read by android/app/build.gradle; never commit a keystore) ----
# BAZARHQ_KEYSTORE_PATH=
# BAZARHQ_KEYSTORE_PASSWORD=
# BAZARHQ_KEY_ALIAS=
# BAZARHQ_KEY_PASSWORD=
